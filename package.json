{
  "name": "idle-solitaire-infinite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An idle solitaire game: the deck is the engine, and the score is a journey through 52! arrangements.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5200",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node tools/run-browser-tests.mjs",
    "sim": "vite-node sim/cli.ts",
    "shot": "node tools/shot.mjs",
    "server": "npm --prefix server run dev"
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "pixi.js": "^8.20.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.0.0",
    "playwright-core": "^1.63.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "engines": { "node": ">=22.12" }
}
